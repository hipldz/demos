{
  "name": "remotion-voiceover",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable local microphone recording and voiceover timeline integration for Remotion projects",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "src",
    "examples",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./styles.css": "./dist/voice.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config examples/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "build:example": "vite build --config examples/vite.config.ts",
    "test": "node --test",
    "check": "npm run typecheck && npm run build && npm test",
    "prepack": "npm run build",
    "pack:local": "node scripts/pack.mjs"
  },
  "peerDependencies": {
    "@remotion/player": ">=4.0.542 <5",
    "react": ">=18 <20",
    "remotion": ">=4.0.542 <5",
    "vite": ">=5 <8"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@remotion/player": "4.0.542",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "dependencies": {
    "sirv": "^3.0.2"
  }
}
